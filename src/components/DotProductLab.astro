---
// Marginalia Atlas component: values, products, and the final sum remain simultaneously visible.
---
<section class="interactive" aria-labelledby="dot-title">
  <span class="eyebrow">Interactive / local calculation</span>
  <h3 id="dot-title">Dot-product lab</h3>
  <p>二つの 2D vector を動かし、対応する要素の積と合計を確認します。</p>
  <div class="control-row"><label for="a1">a₁</label><input id="a1" type="range" min="-4" max="4" value="3" /><output for="a1">3</output></div>
  <div class="control-row"><label for="a2">a₂</label><input id="a2" type="range" min="-4" max="4" value="1" /><output for="a2">1</output></div>
  <div class="control-row"><label for="b1">b₁</label><input id="b1" type="range" min="-4" max="4" value="2" /><output for="b1">2</output></div>
  <div class="control-row"><label for="b2">b₂</label><input id="b2" type="range" min="-4" max="4" value="-1" /><output for="b2">-1</output></div>
  <p class="answer" id="dot-result" aria-live="polite"></p>
</section>
<script>
  const ids = ["a1", "a2", "b1", "b2"] as const;
  const controls = ids.map((id) => document.querySelector<HTMLInputElement>(`#${id}`));
  const outputs = ids.map((id) => document.querySelector<HTMLOutputElement>(`output[for="${id}"]`));
  const result = document.querySelector<HTMLParagraphElement>("#dot-result");
  if (controls.every(Boolean) && outputs.every(Boolean) && result) {
    const inputs = controls as HTMLInputElement[];
    const read = (id: string) => Number(document.querySelector<HTMLInputElement>(`#${id}`)?.value ?? 0);
    const update = () => {
      const [a1, a2, b1, b2] = ids.map(read);
      inputs.forEach((input, index) => (outputs[index]!.textContent = input.value));
      const first = a1 * b1, second = a2 * b2;
      result.textContent = `(${a1} × ${b1}) + (${a2} × ${b2}) = ${first} + ${second} = ${first + second}`;
    };
    inputs.forEach((input) => input.addEventListener("input", update));
    update();
  }
</script>
